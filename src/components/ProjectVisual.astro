---
interface Props { theme: string; label: string; }
const {theme, label} = Astro.props;
---
<div class:list={['project-visual', theme]} aria-label={label} role="img">
  <span class="visual-caption">{label}</span>
  {theme === 'tuner' && <div class="training-window"><div class="window-bar"><span class="window-controls">● ● ●</span><span>easy-finetuner / workspace</span></div><div class="terminal-body"><span class="terminal-muted">Your knowledge. Your model.</span><strong>Make intelligence<br/>your own<span class="lime">.</span></strong><div class="terminal-command"><span>~</span> python train.py <span>--model Qwen</span></div><div class="training-line"><span>Training pipeline</span><span class="lime">LoRA</span></div><div class="mini-bars">{Array.from({length: 29}, (_,i) => <i style={`--height: ${20 + ((i * 17) % 40)}px`}/>)}</div><div class="terminal-foot"><span>dataset.json</span><span>merged / model</span></div></div></div>}
  {theme === 'pezaas' && <div class="pezaas-art"><span class="art-wordmark">pezaas<span>®</span></span><strong>A little more<br/>social<span class="lime">.</span></strong><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="social-tile social-one">@</div><div class="social-tile social-two">♥</div><div class="social-tile social-three">▶</div><span class="art-footer">BUILT FOR RWANDA. MADE TO CONNECT.</span></div>}
  {theme === 'outreach' && <div class="outreach-art"><span class="art-wordmark">outreach<span>hub</span></span><div class="workflow"><div class="workflow-node"><span>◎</span><b>Find your people</b><small>Lead generation</small></div><div class="workflow-connector"></div><div class="workflow-node middle"><span>✦</span><b>Start a conversation</b><small>Customer outreach</small></div><div class="workflow-connector"></div><div class="workflow-node"><span>◇</span><b>Build a connection</b><small>One workspace</small></div></div></div>}
  {theme === 'veo' && <div class="veo-art"><span class="art-wordmark">VEO <span>STREAM</span></span><div class="cinema-scene"><div class="sun"></div><div class="mountain back"></div><div class="mountain front"></div><div class="play-disc">▶</div><div class="cinema-frame"></div></div><div class="cinema-footer"><span>AN IDEA. A PROMPT. A NEW WORLD.</span><span>00:08</span></div></div>}
  {theme === 'trading' && <div class="trading-art"><span class="art-wordmark">viper<span> / trade logger</span></span><div class="chart-grid"><svg viewBox="0 0 500 180" fill="none"><path d="M0 150 30 125 60 137 90 100 120 112 150 70 180 90 210 65 240 85 270 45 300 58 330 30 360 55 390 25 420 40 450 15 500 25" stroke="#50586C" stroke-width="3"/><path d="M0 150 30 125 60 137 90 100 120 112 150 70 180 90 210 65 240 85 270 45 300 58 330 30 360 55 390 25 420 40 450 15 500 25V180H0Z" fill="url(#chart-fill)"/><defs><linearGradient id="chart-fill" x2="0" y2="1"><stop stop-color="#7B9ACC" stop-opacity=".35"/><stop offset="1" stop-color="#7B9ACC" stop-opacity="0"/></linearGradient></defs></svg></div><span class="art-footer">PLAN. EXECUTE. REFLECT.</span></div>}
  {theme === 'study' && <div class="study-art"><span class="art-wordmark">study craft<span>✦</span></span><strong>Big ideas.<br/>Small steps.</strong><div class="learning-steps"><span>Explore</span><i></i><span>Understand</span><i></i><span>Apply</span></div></div>}
</div>
