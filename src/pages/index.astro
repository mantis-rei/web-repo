---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import {projects} from '../data/projects';
const base = import.meta.env.BASE_URL;
const expertise = [
  {icon:'spark',title:'AI that does the work.',text:'From prompt architecture to open-source model fine-tuning. Purpose-built AI that fits the problem.',tags:['LLM fine-tuning','Prompt engineering','Generative AI','Python']},
  {icon:'layers',title:'Less friction. More flow.',text:'Connected APIs and automated workflows that turn repetitive processes into useful systems.',tags:['n8n','API integration','Workflow automation','AWS']},
  {icon:'code',title:'Built for the real world.',text:'Thoughtful web experiences with clear interfaces, a solid foundation, and room to grow.',tags:['React','TypeScript','Astro','Firebase']},
];
---
<Layout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="tiny-cross">✳</span> AI SOLUTIONS DEVELOPER & CREATIVE BUILDER</div>
      <h1 id="hero-title">Intelligent<br/>systems.<br/><span>Human impact.</span></h1>
      <p class="hero-intro">I’m <strong>Blaise Dushime Muhoza.</strong> I bring AI, automation, and modern web development together to turn ambitious ideas into things people can use.</p>
      <div class="hero-actions"><a href="#work" class="button button-primary">Explore my work <Icon name="layers" size={18}/></a><a href="#contact" class="text-link">Let’s build something <span class="link-line"></span></a></div>
      <div class="hero-bottom"><span class="availability"><i></i> Open to opportunities</span><span>Kigali, Rwanda <span class="muted">/</span> Working globally</span></div>
    </div>
    <div class="hero-portrait">
      <div class="portrait-topline"><span>A LITTLE CURIOUS. ALWAYS BUILDING.</span><Icon name="spark" size={22}/></div>
      <div class="portrait-picture"><img src={`${base}images/blaise-portrait.webp`} alt="Blaise Dushime Muhoza, AI solutions developer in Kigali" width="1086" height="1448" fetchpriority="high"/><div class="portrait-grain"></div><div class="portrait-name">Blaise<span>Dushime Muhoza</span></div><span class="portrait-alias">ALSO KNOWN AS VIPER</span></div>
      <div class="portrait-bottomline"><span>FOUNDER, WIMAZA TECHNOLOGIES</span><span>RW <span class="lime">✳</span></span></div>
    </div>
  </section>

  <div class="specialty-strip"><div class="container strip-inner"><span>AI ENGINEERING</span><i>✳</i><span>WORKFLOW AUTOMATION</span><i>✳</i><span>MODERN WEB EXPERIENCES</span><i>✳</i><span>CLOUD INFRASTRUCTURE</span></div></div>

  <section id="work" class="section container work-section" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">IDEAS, MADE REAL</p><h2 id="work-title">Selected <span class="serif">work.</span></h2></div><p>A few things I’ve built.<br/>Different challenges. The same curiosity.</p></div>
    <div class="work-toolbar"><div class="filters" aria-label="Filter projects"><button data-filter="all" aria-pressed="true">All work</button><button data-filter="ai" aria-pressed="false">AI & automation</button><button data-filter="web" aria-pressed="false">Web & products</button></div><a class="github-link" href="https://github.com/mantis-rei" target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/> Explore GitHub</a></div>
    <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>
    <div class="project-grid">
      {projects.map(project => <article class="project-card" data-project={['easy-fine-tuner','outreachhub','veo-stream'].includes(project.slug)?'ai':'web'}>
        <a class="project-image-link" href={`${base}work/${project.slug}/`} aria-label={`Explore ${project.title}`}><ProjectVisual theme={project.theme} label={project.label}/><span class="project-open"><Icon name="layers" size={20}/><span>Explore project</span></span></a>
        <div class="project-meta"><span class="eyebrow">{project.category}</span><span class="project-type">{project.github?'OPEN SOURCE':'INDEPENDENT PROJECT'}</span></div>
        <h3><a href={`${base}work/${project.slug}/`}>{project.title}</a></h3><p>{project.description}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag=><li>{tag}</li>)}</ul>
      </article>)}
    </div>
    <div class="work-note"><Icon name="code" size={20}/><p>Curious about what’s under the hood? <a href="https://github.com/mantis-rei" target="_blank" rel="noopener noreferrer">You’ll find more experiments on GitHub.</a></p></div>
  </section>

  <section id="expertise" class="expertise-section section" aria-labelledby="expertise-title"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">WHERE I CAN HELP</p><h2 id="expertise-title">A builder’s <span class="serif">toolkit.</span></h2></div><p>From the first “what if”<br/>to a product that works.</p></div>
    <div class="expertise-grid">{expertise.map(item=><article class="expertise-card"><div class="expertise-icon"><Icon name={item.icon} size={28}/></div><h3>{item.title}</h3><p>{item.text}</p><ul class="expertise-tags">{item.tags.map(tag=><li>{tag}</li>)}</ul></article>)}</div>
    <div class="approach-note"><span class="tiny-cross">✳</span><p>Good technology starts with understanding the people who will use it.</p></div>
  </div></section>

  <section id="about" class="about-section section container" aria-labelledby="about-title">
    <div class="about-intro"><p class="eyebrow">THE PERSON BEHIND THE PROJECTS</p><h2 id="about-title">Driven by curiosity.<br/>Grounded in <span class="serif">purpose.</span></h2><div class="about-signature">Blaise.</div><a class="text-link" href={`${base}blaise-dushime-cv.pdf`} target="_blank" rel="noopener noreferrer">A little more about me <Icon name="download" size={17}/></a></div>
    <div class="about-story"><p class="about-lead">I build at the intersection of AI, the cloud, and the everyday problems worth solving.</p><p>Based in Kigali, Rwanda, I’m an AI solutions developer, prompt engineer, and the founder of WIMAZA Technologies. My work brings cloud infrastructure and generative AI together with practical, user-focused web development.</p><p>I’m especially interested in open-source models, useful automations, and building tools that make complex technology more approachable. Alongside building, I’m studying Information Technology at the Adventist University of Central Africa.</p>
    <div class="timeline"><div><span class="timeline-date">JUN 2026 — PRESENT</span><h3>Founder & Chief Executive Officer</h3><p>WIMAZA Technologies · AI products & B2B services</p></div><div><span class="timeline-date">FEB — JUL 2026</span><h3>Content Creator · Internship</h3><p>Nazli Tech School · AI content creation</p></div><div><span class="timeline-date">2025 — 2029 · IN PROGRESS</span><h3>Bachelor of Technology, Information Technology</h3><p>Adventist University of Central Africa</p></div></div>
    <p class="community-note"><Icon name="globe" size={18}/> Open to collaboration and education-focused volunteering.</p></div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="container contact-inner">
    <div class="contact-main"><p class="eyebrow"><span class="availability-dot"></span> GOOD WORK STARTS WITH A CONVERSATION</p><h2 id="contact-title">Have something<br/>in <span class="serif">mind?</span><span class="contact-asterisk">✳</span></h2><p>A product idea, a tricky workflow, or a role that feels like a fit.<br/>I’d love to hear about it.</p><div class="email-row"><a href="mailto:bdushime34@gmail.com">bdushime34@gmail.com</a><button data-copy-email aria-label="Copy email address"><Icon name="copy" size={22}/></button></div><p id="copy-status" class="copy-status" role="status" aria-live="polite"></p></div>
    <aside class="contact-aside"><div><span class="eyebrow">FIND ME ELSEWHERE</span><a href="https://github.com/mantis-rei" target="_blank" rel="noopener noreferrer"><Icon name="github"/> GitHub <span>@mantis-rei</span></a><a href="https://www.linkedin.com/in/ukomeye/" target="_blank" rel="noopener noreferrer"><span class="linkedin-icon">in</span> LinkedIn <span>Let’s connect</span></a><a href={`${base}blaise-dushime-cv.pdf`} target="_blank" rel="noopener noreferrer"><Icon name="download"/> Résumé <span>Download PDF</span></a></div><div class="local-time"><Icon name="globe" size={18}/><span>Kigali, Rwanda</span><time data-kigali-time>UTC +02:00</time></div></aside>
  </div></section>
</Layout>
