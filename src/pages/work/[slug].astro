---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const {project} = Astro.props;
const base=import.meta.env.BASE_URL;
const next=projects[(projects.findIndex(item=>item.slug===project.slug)+1)%projects.length];
---
<Layout title={`${project.title} — Blaise Dushime Muhoza`} description={project.description}>
  <article class="case-study container">
    <a href={`${base}#work`} class="back-link">Back to selected work</a>
    <div class="case-heading"><p class="eyebrow">{project.category}</p><h1>{project.title}<span class="lime">.</span></h1><p>{project.intro}</p><div class="case-links">{project.github&&<a class="button button-primary" href={project.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/> View source</a>}{project.live&&<a class="button" href={project.live} target="_blank" rel="noopener noreferrer"><Icon name="globe" size={18}/> Visit project</a>}<a class="text-link" href={`${base}#contact`}>Discuss a similar project</a></div></div>
    <ProjectVisual theme={project.theme} label={project.label} preview={project.preview} priority/>
    <div class="case-body"><aside><p class="eyebrow">BUILT WITH</p><ul class="tags">{project.tags.map(tag=><li>{tag}</li>)}</ul><p class="eyebrow case-role">CREATOR</p><p>Blaise Dushime Muhoza</p></aside><div class="case-story"><section><h2>The challenge</h2><p>{project.challenge}</p></section><section><h2>The approach</h2><p>{project.approach}</p></section><section><h2>Inside the project</h2><ul class="feature-list">{project.features.map(feature=><li><Icon name="check" size={18}/><span>{feature}</span></li>)}</ul></section><p class="source-note">{project.source}</p></div></div>
    <div class="next-project"><span class="eyebrow">KEEP EXPLORING</span><a href={`${base}work/${next.slug}/`}>{next.title}<Icon name="layers" size={28}/></a></div>
  </article>
</Layout>
