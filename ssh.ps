# 1. Remove any existing remote
git remote remove origin

# 2. Add HTTPS remote
git remote add origin https://github.com/mantis-rei/web-repo.git

# 3. Clear any cached GitHub credentials (old idush token)
cmdkey /delete:git:https://github.com

# 4. Add all files and commit (skip if already committed)
git add .
git commit -m "Initial commit for Netlify deployment"

# 5. Push to GitHub — it will prompt for username/password
git push -u origin main
